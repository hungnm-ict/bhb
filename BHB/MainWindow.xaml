<controls:BaseWindow x:Class="BHB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:BHB.Common.Controls;assembly=BHB.Common"
        xmlns:views="clr-namespace:BHB.Views"
        Title="BHB — Bit Heroes Bot"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        Style="{StaticResource MaterialDesignWindow}"
        Background="#F4F6FA"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontSize="13"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <controls:BaseWindow.Resources>
        <!-- Nav rail button: icon over label, highlighted when its page is active -->
        <Style x:Key="NavRailButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="60" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#B9C0D4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </controls:BaseWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Nav rail ── -->
        <Border Grid.Column="0" Width="72" Background="#1E2233">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,18,0,20" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Robot" Width="26" Height="26"
                                             Foreground="#7C8CF8" HorizontalAlignment="Center" />
                    <TextBlock Text="BHB" FontSize="12" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Command="{Binding Path=ShowAccountsCommand}">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="AccountMultiple" Width="22" Height="22"
                                                     HorizontalAlignment="Center" />
                            <TextBlock Text="Accounts" FontSize="10" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavRailButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsAccountsPage}" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="#2C3149" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding Path=ShowToolsCommand}">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Tools" Width="22" Height="22"
                                                     HorizontalAlignment="Center" />
                            <TextBlock Text="Tools" FontSize="10" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavRailButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsToolsPage}" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="#2C3149" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Page host ── -->
        <Grid Grid.Column="1">
            <views:AccountsPage Visibility="{Binding Path=IsAccountsPage,
                                             Converter={StaticResource BooleanToVisibilityConverter}}" />
            <views:ToolsPage Visibility="{Binding Path=IsToolsPage,
                                          Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</controls:BaseWindow>
