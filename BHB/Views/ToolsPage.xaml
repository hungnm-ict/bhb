<UserControl x:Class="BHB.Views.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,4">
            <TextBlock Text="Engine Tools" FontSize="18" FontWeight="Bold" Foreground="#1A1A2E" />
            <TextBlock FontSize="12" Foreground="#8A90A6" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Diagnostics for capture, template matching and click delivery. These act on the window bound to the selected account." />
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="24,14,24,0" Padding="18,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.07"
                                  Color="#000000" Direction="270" />
            </Border.Effect>
            <StackPanel>
                <TextBlock FontSize="12" Foreground="#8A90A6" Margin="0,0,0,10">
                    <Run Text="Target account:" />
                    <Run Text="{Binding Path=SelectedAccount.Name, Mode=OneWay, FallbackValue='none'}"
                         FontWeight="SemiBold" Foreground="#1A1A2E" />
                    <Run Text=" — " />
                    <Run Text="{Binding Path=SelectedAccount.SelectedWindow.Title, Mode=OneWay, FallbackValue='no window bound'}" />
                </TextBlock>

                <WrapPanel Orientation="Horizontal">
                    <Button Command="{Binding Path=CaptureTestCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="34" Padding="14,0" FontSize="12" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Camera" VerticalAlignment="Center" />
                            <TextBlock Text="Capture" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Path=SaveCaptureCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="34" Padding="14,0" FontSize="12" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                            <TextBlock Text="Save" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Path=ClickTestCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="34" Padding="14,0" FontSize="12" Margin="0,0,8,8"
                            ToolTip="PostMessage click — non-intrusive, may be ignored by the game">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CursorDefaultClickOutline" VerticalAlignment="Center" />
                            <TextBlock Text="Click (post)" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Path=DemoQuestCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="34" Padding="14,0" FontSize="12" Margin="0,0,8,8"
                            ToolTip="Moves the real cursor and takes focus">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CursorPointer" VerticalAlignment="Center" />
                            <TextBlock Text="Click (cursor)" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Path=DemoTouchCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="34" Padding="14,0" FontSize="12" Margin="0,0,8,8"
                            ToolTip="Touch injection — non-intrusive">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="GestureTap" VerticalAlignment="Center" />
                            <TextBlock Text="Click (touch)" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Path=DiagnoseCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="34" Padding="14,0" FontSize="12" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stethoscope" VerticalAlignment="Center" />
                            <TextBlock Text="Diagnose" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,16,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Capture preview -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CAPTURE PREVIEW" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8A90A6" Margin="0,0,0,8" />
                    <Image Grid.Row="1" Source="{Binding Path=LastCapture}" Stretch="Uniform" />
                </Grid>
            </Border>

            <!-- Tool log -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="14,14,14,10" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TOOL LOG" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8A90A6" Margin="0,0,0,8" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Path=ToolLog}"
                             BorderThickness="0" FontFamily="Consolas" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
